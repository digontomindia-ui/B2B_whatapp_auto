generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  tokens       Token[]

  @@map("admin")
}

model Token {
  id      String @id
  admin   Admin  @relation(fields: [adminId], references: [id])
  adminId String

  @@map("tokens")
}
